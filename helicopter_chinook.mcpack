pack_format: 6

# Helicopter Chinook for Minecraft Bedrock Edition

# Define the helicopter model

entity.helicopter_chinook: {
    format_version: 1.10.0
    "minecraft:client_entity": {
        "description": {
            "identifier": "helicopter_chinook:helicopter_chinook",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "components": {
            "minecraft:geometry": {
                "default": "geometry.helicopter_chinook"
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "helicopter_chinook",
                    "render_method": "alpha"
                }
            }
        }
    }
}

# Define the helicopter geometry

geometry.helicopter_chinook: {
    format_version: 1.12.0
    "minecraft:geometry": [
        {
            "description": {
                "identifier": "geometry.helicopter_chinook",
                "texture_width": 64,
                "texture_height": 64,
                "visible_bounds_width": 4,
                "visible_bounds_height": 4,
                "visible_bounds_offset": [0, 1.5, 0]
            },
            "bones": [
                {
                    "name": "body",
                    "pivot": [0, 1.5, 0],
                    "cubes": [
                        {
                            "origin": [-2, 0, -2],
                            "size": [4, 4, 13],
                            "uv": [0, 0]
                        }
                    ]
                },
                {
                    "name": "rotor_front",
                    "parent": "body",
                    "pivot": [0, 3.5, -6.5],
                    "cubes": [
                        {
                            "origin": [-1, 0, -1],
                            "size": [2, 1, 2],
                            "uv": [0, 17]
                        }
                    ]
                },
                {
                    "name": "rotor_back",
                    "parent": "body",
                    "pivot": [0, 3.5, 6.5],
                    "cubes": [
                        {
                            "origin": [-1, 0, -1],
                            "size": [2, 1, 2],
                            "uv": [0, 17]
                        }
                    ]
                },
                {
                    "name": "door",
                    "parent": "body",
                    "pivot": [2, 1.5, 0],
                    "cubes": [
                        {
                            "origin": [0, 0, -1],
                            "size": [2, 4, 2],
                            "uv": [0, 20]
                        }
                    ]
                }
            ]
        }
    ]
}

# Define the helicopter behavior

entity.helicopter_chinook: {
    format_version: 1.10.0
    "minecraft:entity": {
        "description": {
            "identifier": "helicopter_chinook:helicopter_chinook",
            "is_spawnable": true,
            "is_summonable": true,
            "is_experimental": false
        },
        "components": {
            "minecraft:rideable": {
                "seat_count": 1,
                "family_types": ["player"]
            },
            "minecraft:movement": {
                "value": 0.1
            },
            "minecraft:health": {
                "value": 100,
                "max": 100
            },
            "minecraft:collision_box": {
                "width": 4,
                "height": 4
            },
            "minecraft:physics": {
                "has_gravity": false
            },
            "minecraft:custom_components": {
                "helicopter_chinook:rotor_animation": {
                    "rotor_speed": 10
                },
                "helicopter_chinook:door_control": {
                    "door_open": false
                }
            }
        }
    }
}

# Define the helicopter crafting recipe

recipes.helicopter_chinook: {
    format_version: 1.10.0
    "minecraft:recipe_shaped": {
        "description": {
            "identifier": "helicopter_chinook:helicopter_chinook"
        },
        "tags": [
            "crafting_table"
        ],
        "pattern": [
            " I ",
            "RDR",
            " I "
        ],
        "key": {
            "I": {
                "item": "minecraft:iron_ingot"
            },
            "R": {
                "item": "minecraft:redstone"
            },
            "D": {
                "item": "minecraft:diamond"
            }
        },
        "result": {
            "item": "helicopter_chinook:helicopter_chinook",
            "count": 1
        }
    }
}

# Define the helicopter spawn egg

items.helicopter_chinook_spawn_egg: {
    format_version: 1.10.0
    "minecraft:item": {
        "description": {
            "identifier": "helicopter_chinook:helicopter_chinook_spawn_egg",
            "category": "Items"
        },
        "components": {
            "minecraft:spawn_egg": {
                "entity_type": "helicopter_chinook:helicopter_chinook"
            }
        }
    }
}

# Define the helicopter textures

textures.helicopter_chinook: {
    format_version: 1.10.0
    "minecraft:texture_set": {
        "color": "#006400",
        "metal": "#808080"
    }
}

# Define the helicopter sounds

sounds.helicopter_chinook: {
    format_version: 1.10.0
    "minecraft:sound_definitions": {
        "helicopter_chinook:rotor_sound": {
            "category": "neutral",
            "sounds": [
                {
                    "name": "helicopter_chinook:rotor",
                    "volume": 1.0,
                    "pitch": 1.0
                }
            ]
        }
    }
}

# Define the helicopter animations

animations.helicopter_chinook: {
    format_version: 1.10.0
    "animations": {
        "animation.helicopter_chinook.rotor_animation": {
            "loop": true,
            "bones": {
                "rotor_front": {
                    "rotation": [0, 0, 360]
                },
                "rotor_back": {
                    "rotation": [0, 0, 360]
                }
            }
        },
        "animation.helicopter_chinook.door_animation": {
            "loop": false,
            "bones": {
                "door": {
                    "position": [0, 0, 2]
                }
            }
        }
    }
}

# Define the helicopter commands

commands.helicopter_chinook: {
    format_version: 1.10.0
    "commands": {
        "summon_helicopter_chinook": {
            "description": "Summon a Helicopter Chinook",
            "command": "/summon helicopter_chinook:helicopter_chinook ~ ~ ~"
        }
    }
}